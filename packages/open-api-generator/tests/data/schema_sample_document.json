{
  "openapi": "3.0.3",
  "info": {
    "title": "py-allspice schema-generation test fixture",
    "version": "0.0.0-test",
    "description": "Hand-built OpenAPI document for the schema-generation tests. Each schema exercises a specific behavior of generate_schemas and the post-passes: SampleUserId (trivial scalar -> RootModel alias -> NewType), SampleUserState (enum -> open enum), SampleUser (object -> ReadOnlyModel, carrying an email field, a length-constrained field, a scalar-alias id, and an enum ref), SampleUserOptions (PascalCase keys -> snake_case fields with aliases), SampleUserProfile (a nested object that stays ReadOnly when SampleUser is promoted to an entity, and carries the one described field, which becomes an attribute docstring in the interface), and SampleUserSelection (a oneOf union -> a bare-union alias, not a NewType)."
  },
  "paths": {},
  "components": {
    "schemas": {
      "SampleUser": {
        "type": "object",
        "required": ["id", "login", "state"],
        "properties": {
          "id": { "$ref": "#/components/schemas/SampleUserId" },
          "login": { "type": "string", "minLength": 1, "maxLength": 40 },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" },
          "state": { "$ref": "#/components/schemas/SampleUserState" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "logins_by_year": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" }
          },
          "profile": { "$ref": "#/components/schemas/SampleUserProfile" }
        }
      },
      "SampleUserId": {
        "type": "integer"
      },
      "SampleUserOptions": {
        "type": "object",
        "required": ["Login"],
        "properties": {
          "Login": { "type": "string" },
          "FullName": { "type": "string" },
          "SourceID": { "type": "integer" }
        }
      },
      "SampleUserProfile": {
        "type": "object",
        "properties": {
          "bio": {
            "type": "string",
            "description": "A short user biography."
          },
          "company": { "type": "string" }
        }
      },
      "SampleUserSelection": {
        "oneOf": [
          { "$ref": "#/components/schemas/SampleUserId" },
          { "type": "array", "items": { "$ref": "#/components/schemas/SampleUserId" } }
        ]
      },
      "SampleUserState": {
        "type": "string",
        "enum": ["active", "invited", "suspended", "deactivated"]
      }
    }
  }
}
